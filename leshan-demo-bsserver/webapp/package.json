    "vue-sse": "^2.5.2",
    "vuetify": "^3.13.7",
    "vuetify3-dialog": "~1.6.x"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@mdi/js": "^7.4.47",
    "@rollup/plugin-node-resolve": "^16.0.3",
